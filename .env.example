# Copy to .env and adjust values for your server.
POSTGRES_DB=video_platform
POSTGRES_USER=video
POSTGRES_PASSWORD=change-me-strong-password

DATABASE_URL=postgres://video:change-me-strong-password@postgres:5432/video_platform
SECRET_KEY=generate-a-long-random-string
ALLOWED_HOSTS=your-domain.com,localhost,127.0.0.1
REDIS_URL=redis://redis:6379/0

MEDIA_URL=/media/
STATIC_URL=/static/

RTMP_SERVER_URL=rtmp://your-domain.com
HLS_SERVER_URL=https://your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com

STORAGE_BACKEND=django.core.files.storage.FileSystemStorage
SESSION_COOKIE_SECURE=true
SECURE_SSL_REDIRECT=true

# AI Analysis Configuration
OPENAI_API_KEY=your-openai-api-key
GOOGLE_API_KEY=your-google-api-key
AI_DEFAULT_PROVIDER=openai
